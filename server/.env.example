# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/rann_dev
# Used only by `npm test` (the tests wipe this database).
TEST_DATABASE_URL=postgres://localhost:5432/rann_test
# Long random string: openssl rand -base64 48
JWT_SECRET=change-me
PORT=8787
HOST=0.0.0.0
# Comma-separated origins allowed to call the API from a browser (the web build).
CORS_ORIGINS=http://localhost:8060,http://localhost:8000
# Email for verification codes and password resets. Brevo (free) — see README.md → Email:
#   SMTP_URL=smtp://<SMTP login, with @ written as %40>:<SMTP key>@smtp-relay.brevo.com:587
#   MAIL_FROM=Rann <the sender address you confirmed in Brevo>
# Leave SMTP_URL empty in development: emails are printed in the server console.
SMTP_URL=
MAIL_FROM=Rann <no-reply@rann.game>
