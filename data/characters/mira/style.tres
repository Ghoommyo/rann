[gd_resource type="Resource" script_class="FightStyle" format=3]

[ext_resource type="Script" path="res://core/defs/fight_style.gd" id="1_style"]
[ext_resource type="Script" path="res://core/style/style_component.gd" id="2_base"]
[ext_resource type="Script" path="res://core/style/stance_component.gd" id="3_stance"]
[ext_resource type="Script" path="res://core/style/parry_component.gd" id="4_parry"]

[sub_resource type="Resource" id="stance"]
script = ExtResource("3_stance")
stances = Array[String](["tiger", "crane"])

[sub_resource type="Resource" id="parry"]
script = ExtResource("4_parry")
window_frames = 5
cooldown_frames = 40

[resource]
script = ExtResource("1_style")
components = Array[ExtResource("2_base")]([SubResource("stance"), SubResource("parry")])
