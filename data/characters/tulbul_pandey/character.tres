[resource]
script = ExtResource("1_def")
id = "tulbul_pandey"
display_name = "Tulbul Pandey"
max_health = 1000
walk_forward_speed = 36
walk_back_speed = 30
style = ExtResource("3_style")
description = "Swaggering cop. Long pokes and a belt whip keep you out; tap forward to parry. Darr nahi lagta… swag lagta hai."
color = Color(0.76, 0.65, 0.42, 1)
moves = Array[ExtResource("2_move")]([ExtResource("4_jab"), ExtResource("5_thappad"), ExtResource("6_police_boot"), ExtResource("7_lathi_poke"), ExtResource("8_sweep"), ExtResource("9_buckle_uppercut"), ExtResource("10_belt_whip"), ExtResource("11_chashma_flip"), ExtResource("12_dabangg_slowmo"), ExtResource("13_throw")])
