; Engine configuration file.
; Godot rewrites this file when settings change in the editor.

config_version=5

[application]

config/name="Rann"
config/description="2.5D fighting game"
run/main_scene="res://scenes/fight.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[physics]

; The fight simulation runs exactly 60 ticks per second (plans/00-architecture.md, Rule 2).
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
; Jitter fix nudges tick timing; we want ticks to be plain and predictable.
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="mobile"
