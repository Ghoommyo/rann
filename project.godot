; Engine configuration file.
; Godot rewrites this file when settings change in the editor.

config_version=5

[application]

config/name="Rann"
config/description="2.5D fighting game"
run/main_scene="res://ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/version="0.5.0"
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.08, 0.06, 0.14, 1)

[autoload]

; Global game flow (mode, chosen characters, scene changes).
Settings="*res://game/settings.gd"
Game="*res://game/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; Wide phones (20:9) show more of the stage instead of black bars.
window/stretch/aspect="expand"
; 4 = sensor landscape: landscape, flips when the phone is turned around.
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input_devices]

; Lets the mouse act as a finger, to test touch controls on desktop (F2 shows them).
pointing/emulate_touch_from_mouse=true

[physics]

; The fight simulation runs exactly 60 ticks per second (plans/00-architecture.md, Rule 2).
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
; Jitter fix nudges tick timing; we want ticks to be plain and predictable.
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="mobile"
; Android and iOS need ETC2/ASTC compressed textures.
textures/vram_compression/import_etc2_astc=true
